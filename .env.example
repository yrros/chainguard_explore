# Template for local development. Copy to .env (git-ignored) and set real values:
#   cp .env.example .env
# Ideally these come from the environment the app runs in, e.g. Kubernetes
# Secrets or a secrets manager, not from a file in the repo directory.
POSTGRES_DB=todos
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
SECRET_KEY=change-me
